# Native Apple Silicon macOS editor build.

.DEFAULT_GOAL := all-macos

PREFIX ?= $(abspath ../macos)/
SUFFIX =
SDL2_CONFIG ?= /opt/homebrew/bin/sdl2-config
APP_BUNDLE := $(abspath ../macos/GoatTracker2Fork.app)
APP_CONTENTS := $(APP_BUNDLE)/Contents

CC ?= clang
CXX ?= clang++
CFLAGS += $(shell $(SDL2_CONFIG) --cflags) -D__MACOSX_CORE__ -O3 -Wall -Iasm
CXXFLAGS += $(CFLAGS) -DHAVE_CXX11 -std=c++11 -fpermissive
LIBS += $(shell $(SDL2_CONFIG) --libs) \
	-framework CoreMIDI \
	-framework CoreAudio \
	-framework CoreFoundation

include Makefile.inc

.PHONY: all-macos editor app tools-macos clean-macos clean-editor clean-app clean-tools-macos

all-macos: editor tools-macos

editor: $(EXE)

app: editor
	$(RM) -r "$(APP_BUNDLE)"
	mkdir -p "$(APP_CONTENTS)/MacOS" "$(APP_CONTENTS)/Resources"
	cp "$(EXE)" "$(APP_CONTENTS)/MacOS/gt2fork-bin"
	cp macos/launcher.sh "$(APP_CONTENTS)/MacOS/gt2fork"
	chmod +x "$(APP_CONTENTS)/MacOS/gt2fork"
	cp macos/Info.plist "$(APP_CONTENTS)/Info.plist"
	sips -s format icns gt2fork.ico \
		--out "$(APP_CONTENTS)/Resources/gt2fork.icns"
	codesign --force --sign - "$(APP_CONTENTS)/MacOS/gt2fork-bin"
	codesign --force --sign - "$(APP_BUNDLE)"

tools-macos: | $(PREFIX)
	PATH="$(dir $(SDL2_CONFIG)):$$PATH" $(MAKE) -C tools all \
		PREFIX="$(PREFIX)" SUFFIX=

$(EXE): | $(PREFIX)

$(PREFIX):
	mkdir -p $@

clean-editor:
	$(RM) *.o *~
	$(RM) asm/*.o
	$(RM) resid/*.o
	$(RM) residfp/*.o
	$(RM) residfp/resample/*.o
	$(RM) rtmidi/*.o
	$(RM) $(EXE)

clean-tools-macos:
	PATH="$(dir $(SDL2_CONFIG)):$$PATH" $(MAKE) -C tools clean \
		PREFIX="$(PREFIX)" SUFFIX=

clean-app:
	$(RM) -r "$(APP_BUNDLE)"

clean-macos: clean-editor clean-tools-macos clean-app
